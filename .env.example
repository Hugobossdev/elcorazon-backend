# Modèle de configuration — copier en `.env` et renseigner.
#
# Aucune valeur réelle ne doit figurer dans ce fichier : il est versionné.
# `.env`, lui, est ignoré par git (voir .gitignore).

# ---------------------------------------------------------------- Django

DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Nombre de proxys entre le client et l'application — **réglage de sécurité**.
# Nginx ajoute à `X-Forwarded-For` au lieu de le remplacer : sans cette valeur,
# un client qui envoie son propre en-tête obtient une identité neuve à chaque
# requête, et le limiteur par adresse IP ne compte plus rien. 1 correspond au
# Nginx de `deploy/` ; 0 si l'application est exposée sans proxy.
NUM_PROXIES=1

# Générer avec :
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=

LOG_LEVEL=INFO

# ---------------------------------------------------------------- base de données

POSTGRES_DB=elcorazon
POSTGRES_USER=elcorazon
POSTGRES_PASSWORD=
POSTGRES_HOST=db          # `localhost` hors Docker
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60

# GeoDjango exige GDAL et GEOS, qui sont des bibliothèques système présentes
# dans l'image Docker et en CI. Mettre à False permet à un poste sans Docker
# d'exécuter le sous-ensemble non géospatial de la suite — jamais de livrer.
GIS_ENABLED=True

# ---------------------------------------------------------------- Redis

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ---------------------------------------------------------------- JWT (ADR-004)

# Paire RSA pour RS256. Générer avec :
#   mkdir -p secrets
#   openssl genpkey -algorithm RSA -out secrets/jwt.pem -pkeyopt rsa_keygen_bits:2048
#   openssl rsa -in secrets/jwt.pem -pubout -out secrets/jwt.pub
#
# Les clés passent par ces deux variables, jamais par un fichier monté : c'est
# la seule forme que tous les hébergements acceptent, et un chemin résiduel
# désignant un volume absent a fait échouer deux déploiements de suite.
#
# Un `env_file` ne sait pas porter de valeur multiligne : replier le PEM sur une
# ligne, sauts de ligne échappés, que `base.py` rétablit.
#   awk 'BEGIN{ORS="\\n"}1' secrets/jwt.pem
#   awk 'BEGIN{ORS="\\n"}1' secrets/jwt.pub
# Là où l'environnement accepte le multiligne — tableau de bord de Render,
# `Secret` Kubernetes — le PEM se colle tel quel, sans repli.
JWT_SIGNING_KEY=
JWT_VERIFYING_KEY=

# ---------------------------------------------------------------- stockage objet
#
# Protocole S3, servi par MinIO en local (ADR-011). Basculer sur AWS S3 ne
# demande que de vider `S3_ENDPOINT_URL`, de poser la vraie région et des
# identifiants IAM — aucune ligne de code ne change.

S3_ENDPOINT_URL=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
# TLS vers le stockage. Faux en local (MinIO en HTTP dans le réseau Docker),
# vrai partout où le stockage est joint par un réseau qu'on ne maîtrise pas.
S3_USE_SSL=False

# Un compartiment par domaine : la politique de lecture se pose **sur le
# compartiment**, donc c'est lui qui sépare ce qui est public de ce qui ne
# l'est jamais.
S3_BUCKET_PRODUCTS=elcorazon-products
S3_BUCKET_BANNERS=elcorazon-banners
S3_BUCKET_USERS=elcorazon-users
S3_BUCKET_DOCUMENTS=elcorazon-documents

# Adresse publique des compartiments publics, vue d'un navigateur. Vide, les
# URL retombent sur `S3_ENDPOINT_URL`, ce qui convient en développement.
S3_PUBLIC_URL=http://localhost:9000

# Durée de vie d'une URL signée, en secondes. Assez pour ouvrir un document,
# trop peu pour qu'un lien copié serve encore le lendemain.
S3_SIGNED_URL_EXPIRE=900

# `path` (hôte/compartiment) ou `virtual` (compartiment.hôte). MinIO ne sait
# faire que le premier ; AWS accepte les deux.
S3_ADDRESSING_STYLE=path

# ---------------------------------------------------------------- métier

# ISO-4217. XOF (franc CFA) n'a aucune décimale — voir ADR-007.
DEFAULT_CURRENCY=XOF

# Encaissement. Le prestataire est résolu à l'appel : le changer ne demande pas
# de déploiement de code. `SandboxGateway` n'appelle personne et convient au
# développement comme aux tests.
PAYMENT_GATEWAY=apps.payments.gateway.SandboxGateway
SANDBOX_CHECKOUT_BASE_URL=https://sandbox.elcorazon.app/checkout

# Secret partagé avec le prestataire, servant à signer ses notifications.
# Laissé vide, **aucune** notification n'est acceptée : une configuration
# oubliée doit fermer la porte, pas l'ouvrir.
PAYMENT_WEBHOOK_SECRET=

# Part des frais de livraison reversée au livreur, en pourcentage. Le solde est
# la commission de la plateforme. Un point de commission ne doit pas demander
# un déploiement.
COURIER_FEE_SHARE_PERCENT=80

# Échantillonnage de l'écriture des positions : un relevé est persisté s'il a
# plus de N secondes ou plus de M mètres d'écart avec le précédent. La
# diffusion temps réel, elle, restera intégrale — c'est elle qui fait
# l'expérience de suivi, pas la persistance.
TRACKING_MIN_WRITE_SECONDS=30
TRACKING_MIN_WRITE_METERS=100

# Rétentions. Politique de conservation, négociable sans redéploiement.
TRACKING_RETENTION_DAYS=30
IDEMPOTENCY_RETENTION_HOURS=72

# Service de notification push. `ConsolePushBackend` n'appelle personne et
# convient au développement comme aux tests ; le connecteur FCM se branche ici.
PUSH_BACKEND=apps.notifications.push.ConsolePushBackend

# ---------------------------------------------------------------- services externes

# Firebase Cloud Messaging. Le connecteur reste débranché tant que cette ligne
# pointe sur la console : les identifiants seuls ne l'activent pas.
PUSH_BACKEND=apps.notifications.push.ConsolePushBackend
# PUSH_BACKEND=apps.notifications.fcm.FirebaseCloudMessagingBackend

# Fichier de compte de service, **monté** comme les clés JWT : c'est un JSON
# multiligne, que `env_file` ne sait pas porter.
# `docker compose` monte ./secrets sur /run/secrets.
FCM_CREDENTIALS_PATH=/run/secrets/fcm.json
FCM_PROJECT_ID=
FCM_TIMEOUT_SECONDS=10

# PayDunya. Le connecteur reste débranché tant que cette ligne pointe sur le bac
# à sable : les clés seules ne suffisent pas à l'activer.
PAYDUNYA_GATEWAY=apps.payments.gateway.SandboxGateway
# PAYDUNYA_GATEWAY=apps.payments.paydunya.PayDunyaGateway

# `test` vise le bac à sable de PayDunya, `live` encaisse pour de bon : c'est la
# seule variable dont une erreur se paie en argent réel.
PAYDUNYA_MODE=test
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_PUBLIC_KEY=
PAYDUNYA_TOKEN=
PAYDUNYA_TIMEOUT_SECONDS=10

# URL que PayDunya appellera pour notifier. Doit être joignable depuis
# l'extérieur : en développement, un tunnel est nécessaire.
PAYDUNYA_CALLBACK_URL=

# PayDunya n'utilise pas de secret partagé : il joint l'empreinte SHA-512 de la
# clé maîtresse à chaque notification. C'est donc `PAYDUNYA_MASTER_KEY` qui
# authentifie, et le secret ci-dessous ne sert qu'au bac à sable, qui signe le corps par HMAC-SHA256.

# Google Maps Platform — itinéraires, géocodage, distances
GOOGLE_MAPS_API_KEY=

# Agora RTC — le backend n'émet qu'un jeton, le média ne transite pas par lui
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# ---------------------------------------------------------------- production

# Requis uniquement par config.settings.prod
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
