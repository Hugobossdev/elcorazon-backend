# Configuration de production — copier en `.env.prod` et renseigner.
#
# Aucune valeur réelle ici : ce fichier est versionné. `.env.prod` ne l'est pas.
#
# Les variables marquées ⚠ n'ont **pas** de valeur par défaut acceptable :
# `docker-compose.prod.yml` refuse de démarrer sans elles, et `config/settings/
# prod.py` refuse de charger. Un oubli devient un échec au démarrage plutôt
# qu'un incident de sécurité découvert plus tard.

# ═══════════════════════════════════════════════════════════════════ Django

DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_DEBUG=False
# ⚠ Le domaine servi. Utilisé par Django, par Nginx (substitution) et par
#   certbot.
DOMAIN=
DJANGO_ALLOWED_HOSTS=

# ⚠ Générer avec :
#     python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=

LOG_LEVEL=INFO

# Nombre de proxys entre le client et l'application — **réglage de sécurité**.
# Nginx ajoute à `X-Forwarded-For` au lieu de le remplacer : sans cette valeur,
# un client qui forge cet en-tête obtient une identité neuve à chaque requête,
# et la limitation par adresse IP ne compte plus rien.
NUM_PROXIES=1

# ═════════════════════════════════════════════════════════════ base de données

POSTGRES_DB=elcorazon
POSTGRES_USER=elcorazon
# ⚠ Générer avec : openssl rand -base64 36
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60
GIS_ENABLED=True

# ═══════════════════════════════════════════════════════════════════ Redis

# ⚠ Redis porte la file Celery et la couche de canaux. Sans mot de passe, il
#   est ouvert à tout ce qui atteint le réseau du compose.
REDIS_PASSWORD=
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0

# ══════════════════════════════════════════════════════════ JWT (ADR-004)

# Générer la paire :
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:4096 -out secrets/jwt.pem
#   openssl rsa -pubout -in secrets/jwt.pem -out secrets/jwt.pub
#
# Les remplacer invalide tous les jetons en circulation : tout le monde se
# reconnecte. C'est le levier de révocation globale, à connaître avant d'en
# avoir besoin.
JWT_PRIVATE_KEY_PATH=/run/secrets/jwt.pem
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt.pub

# ════════════════════════════════════════════════════════ dimensionnement

# Règle usuelle : 2 × cœurs + 1. Chaque worker Uvicorn tient plusieurs milliers
# de connexions WebSocket, la contrainte est la mémoire, pas le nombre.
GUNICORN_WORKERS=4
CELERY_CONCURRENCY=4

# ══════════════════════════════════════════════════════════ stockage objet

# ⚠ Le stockage porte les pièces d'identité des livreurs. Elles vivent dans un
#   compartiment **séparé et privé**, sans politique de lecture anonyme : toute
#   lecture passe par une URL signée émise par le serveur (ADR-011).
S3_ENDPOINT_URL=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Faux ici parce que MinIO est joint par le réseau interne de Docker, qui ne
# sort pas de la machine. À passer à vrai dès que le stockage est ailleurs —
# un service géré, une autre machine, AWS S3.
S3_USE_SSL=False

S3_BUCKET_PRODUCTS=elcorazon-products
S3_BUCKET_BANNERS=elcorazon-banners
S3_BUCKET_USERS=elcorazon-users
S3_BUCKET_DOCUMENTS=elcorazon-documents

# ⚠ Adresse **publique** des compartiments publics. Elle doit passer par le
#   domaine servi par Nginx et non par `minio:9000`, que seul le réseau Docker
#   atteint : sans elle, les applications reçoivent des URL d'images
#   injoignables depuis un téléphone.
S3_PUBLIC_URL=https://example.com/media

S3_SIGNED_URL_EXPIRE=900
S3_ADDRESSING_STYLE=path

# Console MinIO : `off` en production. La passer à `on` expose une interface
# d'administration du stockage.
MINIO_BROWSER=off

# ═════════════════════════════════════════════════════════════════ TLS

# Adresse de contact Let's Encrypt — reçoit les avis d'expiration.
ACME_EMAIL=

# ═════════════════════════════════════════════════════════════ paiements

# ⚠ Le connecteur réel, et non le bac à sable.
PAYDUNYA_GATEWAY=apps.payments.paydunya.PayDunyaGateway

# ⚠ `live` encaisse pour de bon. C'est la seule variable dont une erreur se
#   paie en argent réel.
PAYDUNYA_MODE=live
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_PUBLIC_KEY=
PAYDUNYA_TOKEN=
PAYDUNYA_TIMEOUT_SECONDS=10
PAYDUNYA_CALLBACK_URL=https://${DOMAIN}/api/v1/payments/webhook/paydunya/

# Les clés utilisées avant le 2 août 2026 sont **compromises** : elles étaient
# distribuées dans les applications Flutter. Voir docs/security/paydunya_rotation.md

# ═══════════════════════════════════════════════════════ services externes

FCM_CREDENTIALS_PATH=/run/secrets/fcm.json
FCM_PROJECT_ID=
FCM_TIMEOUT_SECONDS=10

# Clé **serveur** — distincte des clés clientes des applications, et restreinte
# par adresse IP côté console. Voir docs/security/google_maps.md
GOOGLE_MAPS_API_KEY=

# Agora — le certificat signe les jetons d'appel et ne quitte jamais le serveur.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_TOKEN_TTL_SECONDS=3600

# ══════════════════════════════════════════════════════════════ messagerie

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# ═════════════════════════════════════════════════════════ origines autorisées

# Domaines du back-office Flutter Web. `CORS_ALLOW_ALL_ORIGINS` est faux en
# production : une liste vide bloque tout appel navigateur d'une autre origine.
CORS_ALLOWED_ORIGINS=https://admin.example
CSRF_TRUSTED_ORIGINS=https://admin.example

# ══════════════════════════════════════════════════════════════ sauvegardes

BACKUP_RETENTION_DAYS=30

# ══════════════════════════════════════════════════════════════ image

IMAGE_TAG=latest
DEFAULT_CURRENCY=XOF
COURIER_FEE_SHARE_PERCENT=80
